# Llama-3.2 is gated. Store a Kaggle secret named HF_TOKEN.
from kaggle_secrets import UserSecretsClient
from huggingface_hub import login

try:
    token = UserSecretsClient().get_secret('HF_TOKEN')
    login(token=token)
    print('Hugging Face login: OK')
except Exception as exc:
    print('HF login was not completed automatically:', exc)
    print('If the model is already cached and accessible, you can continue.')
import torch
from transformers import AutoModelForCausalLM
import matplotlib.pyplot as plt

model = AutoModelForCausalLM.from_pretrained('meta-llama/Llama-3.2-1B',)


layers_to_analyze = [0, 7, 15]
svd_results = {}

for k in layers_to_analyze:
    print(f"\nAnalyzing layer {k}...")


    q_weight = (
        model.model.layers[k]
        .self_attn.q_proj.weight
        .detach()
        .float()
    )


    U, S, Vh = torch.linalg.svd(
        q_weight, full_matrices=False
    )


    energy_ratios = (
        torch.cumsum(S ** 2, dim=0)
        / torch.sum(S ** 2)
        * 100
    )


    rank_50 = (
        torch.searchsorted(
            energy_ratios,
            torch.tensor(50.0, device=energy_ratios.device)
        ).item() + 1
    )

    print(f"Layer {k}: minimum rank for 50% energy = {rank_50}")


    singular_values = S.cpu().numpy()
    cumulative_energy = energy_ratios.cpu().numpy()

    svd_results[k] = {
        "rank_50": rank_50,
        "singular_values": singular_values,
        "cumulative_energy": cumulative_energy,
    }


    plt.figure(figsize=(8, 5))
    plt.plot(
        range(1, 201),
        cumulative_energy[:200]
    )
    plt.axhline(
        50, linestyle="--",
        label="50% energy threshold"
    )
    plt.xlabel("Rank")
    plt.ylabel("Cumulative energy (%)")
    plt.title(f"Layer {k}: Cumulative Energy")
    plt.xlim(1, 200)
    plt.grid(True, alpha=0.3)
    plt.legend()
    plt.tight_layout()
    plt.savefig(f"layer_{k}_cumulative_energy.png", dpi=200)
    plt.show()
    plt.close()


    plt.figure(figsize=(8, 5))
    plt.bar(
        range(1, 201),
        singular_values[:200]
    )
    plt.xlabel("Singular Value Index")
    plt.ylabel("Singular Value Magnitude")
    plt.title(f"Layer {k}: Singular Values")
    plt.xlim(0, 201)
    plt.grid(axis="y", alpha=0.3)
    plt.tight_layout()
    plt.savefig(f"layer_{k}_singular_values.png", dpi=200)
    plt.show()
    plt.close()


    del q_weight, U, S, Vh, energy_ratios

print("\nSummary: Minimum rank for 50% cumulative energy")
for k in layers_to_analyze:
    print(f"Layer {k}: rank = {svd_results[k]['rank_50']}")
